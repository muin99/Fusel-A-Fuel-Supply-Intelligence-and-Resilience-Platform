{
 "uid": "fuel-ops",
 "title": "Fuel Ops Platform",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "job",
    "type": "custom",
    "query": "fuel-api,fuel-api-local",
    "current": {
     "text": "fuel-api",
     "value": "fuel-api"
    },
    "options": [
     {
      "text": "fuel-api",
      "value": "fuel-api",
      "selected": true
     },
     {
      "text": "fuel-api-local",
      "value": "fuel-api-local",
      "selected": false
     }
    ]
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Platform status",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": []
  },
  {
   "type": "stat",
   "title": "Service level",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.9
       },
       {
        "color": "green",
        "value": 0.98
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sim_service_level{job=\"$job\"}"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Sim tick",
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sim_tick{job=\"$job\"}"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Simulator circuit",
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "CLOSED",
         "color": "green"
        },
        "1": {
         "text": "HALF-OPEN",
         "color": "yellow"
        },
        "2": {
         "text": "OPEN",
         "color": "red"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "simulator_circuit_state{job=\"$job\"}"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Degraded mode",
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "NORMAL",
         "color": "green"
        },
        "1": {
         "text": "DEGRADED",
         "color": "red"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "platform_degraded_mode{job=\"$job\"}"
    }
   ]
  },
  {
   "type": "stat",
   "title": "SSE stream",
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red"
        },
        "1": {
         "text": "CONNECTED",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "simulator_stream_connected{job=\"$job\"}"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Prediction confidence",
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.5
       },
       {
        "color": "green",
        "value": 0.7
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "prediction_confidence{job=\"$job\"}"
    }
   ]
  },
  {
   "type": "row",
   "title": "Application",
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Request rate",
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (route) (rate(http_requests_total{job=\"$job\"}[1m]))",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Latency p50 / p95 / p99",
   "gridPos": {
    "x": 8,
    "y": 6,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"$job\"}[1m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"$job\"}[1m])))",
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"$job\"}[1m])))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Error rate (5xx)",
   "gridPos": {
    "x": 16,
    "y": 6,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(sum(rate(http_requests_total{job=\"$job\",status=~\"5..\"}[1m])) or vector(0)) / clamp_min(sum(rate(http_requests_total{job=\"$job\"}[1m])), 1e-9)",
     "legendFormat": "5xx ratio"
    }
   ]
  },
  {
   "type": "row",
   "title": "Simulator integration",
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Simulator calls by outcome",
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (rate(simulator_requests_total{job=\"$job\"}[1m]))",
     "legendFormat": "{{outcome}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Simulator latency p95",
   "gridPos": {
    "x": 8,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(simulator_request_duration_seconds_bucket{job=\"$job\"}[1m])))",
     "legendFormat": "{{endpoint}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Stale / invalid responses",
   "gridPos": {
    "x": 16,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(simulator_stale_responses_total{job=\"$job\"}[1m])",
     "legendFormat": "stale"
    },
    {
     "refId": "B",
     "expr": "sum(rate(simulator_invalid_responses_total{job=\"$job\"}[1m]))",
     "legendFormat": "invalid"
    }
   ]
  },
  {
   "type": "row",
   "title": "Intelligence",
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Forecast abs error (mean, L/tick)",
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (fuel_type) (rate(forecast_abs_error_liters_sum{job=\"$job\"}[5m])) / clamp_min(sum by (fuel_type) (rate(forecast_abs_error_liters_count{job=\"$job\"}[5m])), 1e-9)",
     "legendFormat": "{{fuel_type}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Shortage alerts & anomalies",
   "gridPos": {
    "x": 8,
    "y": 22,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (severity) (increase(shortage_alerts_total{job=\"$job\"}[5m]))",
     "legendFormat": "shortage {{severity}}"
    },
    {
     "refId": "B",
     "expr": "sum(increase(anomalies_detected_total{job=\"$job\"}[5m]))",
     "legendFormat": "anomalies"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Decisions & fallback activations",
   "gridPos": {
    "x": 16,
    "y": 22,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (policy, outcome) (increase(decisions_total{job=\"$job\"}[5m]))",
     "legendFormat": "{{policy}} {{outcome}}"
    },
    {
     "refId": "B",
     "expr": "sum by (reason) (increase(decision_fallback_total{job=\"$job\"}[5m]))",
     "legendFormat": "fallback: {{reason}}"
    }
   ]
  },
  {
   "type": "row",
   "title": "System",
   "gridPos": {
    "x": 0,
    "y": 29,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "CPU (process)",
   "gridPos": {
    "x": 0,
    "y": 30,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(process_cpu_seconds_total{job=\"$job\"}[1m])",
     "legendFormat": "cpu cores"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Memory",
   "gridPos": {
    "x": 12,
    "y": 30,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "process_resident_memory_bytes{job=\"$job\"}",
     "legendFormat": "rss"
    },
    {
     "refId": "B",
     "expr": "nodejs_heap_size_used_bytes{job=\"$job\"}",
     "legendFormat": "heap used"
    }
   ]
  }
 ]
}