# ---- Copy to .env and adjust. Never commit .env ----
NODE_ENV=development
PORT=4000

# Simulator (organizer-provided)
SIMULATOR_URL=http://localhost:8000
SIMULATOR_TIMEOUT_MS=3000
SIMULATOR_RETRIES=3
SIMULATION_SPEED=2
TICK_MINUTES=15
SIMULATOR_START_MODE=paused

# Data (compose maps postgres to host port 5433)
POSTGRES_USER=fuelops
POSTGRES_PASSWORD=fuelops
POSTGRES_DB=fuelops
DATABASE_URL=postgres://fuelops:fuelops@localhost:5433/fuelops
REDIS_URL=redis://localhost:6379

# Auth — operator actions (approve/submit allocations, inject events) need a token
JWT_SECRET=change-me-in-.env
OPERATOR_PASSWORD=operator
STATION_PASSWORD=station
VIEWER_PASSWORD=viewer

# Generative AI (optional — template explanations are used when unset)

GPT_API_KEY=

# Decision engine
AUTO_DISPATCH=true
MIN_CONFIDENCE_FOR_AUTO=0.6

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api
GRAFANA_ADMIN_PASSWORD=admin

# Per-IP API rate limit (req/min). The load test raises it: all k6 VUs share one IP.
RATE_LIMIT_PER_MIN=6000
OPENAI_MODEL=gpt-4.1-mini
