{
  "name": "fuel-ops-platform",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter api --filter web run dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "infra:up": "docker compose -f docker-compose.yml -f docker-compose.local-monitoring.yml up -d simulator postgres redis prometheus grafana",
    "infra:down": "docker compose down",
    "sim:run": "curl -s -X POST http://localhost:8000/admin/run",
    "sim:pause": "curl -s -X POST http://localhost:8000/admin/pause",
    "sim:step": "curl -s -X POST http://localhost:8000/admin/step",
    "sim:reset": "curl -s -X POST http://localhost:8000/admin/reset",
    "loadtest": "docker run --rm -i --add-host=host.docker.internal:host-gateway -e VUS -e API_URL -v \"$PWD/loadtest:/scripts:ro\" -v \"$PWD/loadtest/results:/results\" grafana/k6:1.3.0 run /scripts/k6-api.js",
    "test:e2e": "pnpm --filter web exec playwright test",
    "judge:check": "node scripts/judge-check.mjs",
    "train:rl": "python3 scripts/train_policy.py"
  },
  "version": "1.0.0"
}
