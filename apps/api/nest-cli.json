{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "forecast/trained-model.json",
        "watchAssets": true
      },
      {
        "include": "forecast/operational-models.json",
        "watchAssets": true
      }
    ]
  }
}
